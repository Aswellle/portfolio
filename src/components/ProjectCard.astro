---
import type { Project } from '../data/projects';

export interface Props { project: Project; index?: number; }
const { project, index = 0 } = Astro.props;
const delay = `${0.06 + index * 0.07}s`;
// owner/repo 用于客户端经同源 /api/stars 实时刷新星标（见 ProjectsSection.astro 脚本）
const githubRepo = project.githubUrl.replace(/^https:\/\/github\.com\//, '');
---

<article
  class="bento-card reveal relative flex flex-col h-full cursor-pointer group"
  style={`transition-delay:${delay}`}
>
  <!-- 左侧渐变竖线条（仅支持 hover 的设备显示，修复 iPad Safari 点击触发的粘滞 hover） -->
  <div class="absolute left-0 inset-y-0 w-1 bg-gradient-to-b from-accent to-accent-purple
              opacity-0 [@media(hover:hover)]:group-hover:opacity-100 transition-opacity duration-300 rounded-l-3xl"
       aria-hidden="true"></div>

  <div class="p-6 flex flex-col flex-1">
    <!-- 标题区 -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="font-semibold text-text text-base leading-tight [@media(hover:hover)]:group-hover:text-accent transition-colors duration-200">
            {project.name}
          </h3>
          {project.nameZh && (
            <span class="text-xs text-text-muted font-mono">{project.nameZh}</span>
          )}
        </div>
        {project.badge && (
          <span class={`mt-1.5 inline-block text-xs font-medium px-2 py-0.5 rounded-full
            ${project.badge === 'Live'    ? 'bg-emerald-50 text-emerald-600 border border-emerald-200'
            : project.badge === 'Flagship' ? 'bg-blue-50 text-blue-600 border border-blue-200'
            :                               'bg-amber-50 text-amber-600 border border-amber-200'}`}>
            {project.badge === 'Live' ? '🟢 已部署' : project.badge === 'Flagship' ? '⭐ 主项目' : '✨ 新'}
          </span>
        )}
      </div>
      {project.stars > 0 && (
        <div class="flex flex-col items-end gap-1 flex-shrink-0">
          <span data-stars-repo={githubRepo}
                class="flex items-center gap-1 text-xs text-text-dim bg-bg-elevated px-2 py-1 rounded-lg">
            <!-- GitHub 官方星标图标（octicon star-16） -->
            <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z"/>
            </svg>
            <span data-stars-value>{project.stars}</span>
          </span>
          <!-- 更新时间戳由客户端脚本在取到实时数据后插入（分钟精度） -->
        </div>
      )}
    </div>

    <!-- 短描述（副标题：比项目名略小的斜体，增强显示度） -->
    <p class="text-sm italic text-text-muted leading-relaxed mb-3">{project.description}</p>

    <!-- 副标题与正文之间的细分隔线 -->
    <div class="h-px bg-border/60 mb-3" aria-hidden="true"></div>

    <!-- 简短描述 -->
    <p class="text-sm text-text-muted leading-relaxed flex-1 mb-4">{project.longDesc}</p>

    <!-- 技术标签 -->
    <div class="flex flex-wrap gap-1.5 mb-5">
      {project.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
    </div>

    <!-- 底部：语言 + 链接 -->
    <div class="flex items-center justify-between pt-4 border-t border-border">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full" style={`background:${project.langColor}`} aria-hidden="true"></span>
        <span class="text-xs text-text-dim font-mono">{project.lang}</span>
      </div>
      <div class="flex items-center gap-3">
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer"
             class="text-xs font-medium text-emerald-600 hover:text-emerald-500 transition-colors duration-150"
             aria-label={`${project.name} 在线演示`}>在线体验 ↗</a>
        )}
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer"
           class="text-xs font-medium text-text-muted hover:text-accent transition-colors duration-150"
           aria-label={`${project.name} GitHub 仓库`}>GitHub ↗</a>
      </div>
    </div>
  </div>
</article>
