---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-16 sm:py-24 px-5 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <div class="reveal mb-12">
      <span class="text-xs font-mono text-accent tracking-widest uppercase font-medium">开源项目</span>
      <h2 class="mt-2 text-3xl font-bold text-text">我正在构建的东西</h2>
      <p class="mt-3 text-text-muted max-w-xl">
        每个项目都是为了解决一个我自己遇到的真实问题——本地优先、隐私友好、面向中文开发者。
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>

    <div class="mt-10 text-center reveal stagger-5">
      <a href="https://github.com/Aswellle?tab=repositories" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors duration-200">
        查看全部 <span data-repo-count>13</span> 个仓库
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // 星标数 / 仓库数实时刷新：经同源 Pages Function 代理 GitHub API。
  // 国内访问链路：浏览器 → /api/*（与站点同一 Cloudflare CDN）→ Cloudflare 边缘 → api.github.com，
  // 避免浏览器直连 GitHub 的高延迟与不稳定。
  // 节流：同一浏览器每 REFRESH_INTERVAL_MS 才重新拉取（localStorage 记录上次成功时间），
  // 页面服务器端缓存上限 1 小时，客户端节流只减少重复请求。
  // 请求失败或超时时保留构建期静态值，静默降级；成功后插入"更新于 HH:mm"时间戳（分钟精度）。
  const timeoutMs = 5000;
  const REFRESH_INTERVAL_MS = 10 * 60 * 1000;
  const STORAGE_KEY = 'portfolio-github-refresh-at';

  async function fetchJson(url: string): Promise<Record<string, unknown> | null> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const res = await fetch(url, { signal: controller.signal });
      return res.ok ? await res.json() : null;
    } catch {
      return null;
    } finally {
      clearTimeout(timer);
    }
  }

  function shouldRefresh(): boolean {
    try {
      const last = Number(localStorage.getItem(STORAGE_KEY) || 0);
      return !last || Date.now() - last >= REFRESH_INTERVAL_MS;
    } catch {
      return true;
    }
  }

  function markRefreshed(): void {
    try {
      localStorage.setItem(STORAGE_KEY, String(Date.now()));
    } catch {
      // localStorage 不可用（隐私模式等）时静默跳过，下次继续尝试
    }
  }

  // 分钟精度：同日显示"更新于 14:26"，跨日显示"更新于 8月7日 14:26"
  function formatUpdatedAt(iso: string): string {
    const d = new Date(iso);
    const now = new Date();
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    const time = `${hh}:${mm}`;
    return d.toDateString() === now.toDateString()
      ? `更新于 ${time}`
      : `更新于 ${d.getMonth() + 1}月${d.getDate()}日 ${time}`;
  }

  const jobs: Array<Promise<boolean>> = [];

  // 更新有星的卡片（渲染时仅 stars > 0 的卡片带 data-stars-repo）
  document.querySelectorAll<HTMLElement>('[data-stars-repo]').forEach((el) => {
    const repo = el.dataset.starsRepo;
    if (!repo) return;
    jobs.push(
      fetchJson(`/api/stars/${repo}`).then((data) => {
        if (!data || typeof data.stars !== 'number') return false;
        const valueEl = el.querySelector<HTMLElement>('[data-stars-value]');
        if (valueEl) valueEl.textContent = String(data.stars);
        if (typeof data.updatedAt === 'string') {
          const ts = document.createElement('span');
          ts.className = 'text-[10px] text-text-dim leading-none mt-0.5';
          ts.textContent = formatUpdatedAt(data.updatedAt);
          el.after(ts);
        }
        return true;
      }),
    );
  });

  // 更新"查看全部 N 个仓库"（仅统计非 fork 仓库，由 /api/profile 实时返回）
  const countEl = document.querySelector<HTMLElement>('[data-repo-count]');
  if (countEl) {
    jobs.push(
      fetchJson('/api/profile').then((data) => {
        if (!data || typeof data.nonForkRepos !== 'number') return false;
        countEl.textContent = String(data.nonForkRepos);
        return true;
      }),
    );
  }

  if (shouldRefresh()) {
    Promise.allSettled(jobs).then((results) => {
      // 任一请求拿到真实数据即记一次刷新；全部失败不记，下个访问周期再试
      if (results.some((r) => r.status === 'fulfilled' && r.value)) markRefreshed();
    });
  }
</script>
