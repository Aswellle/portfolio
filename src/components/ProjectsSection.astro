---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-16 sm:py-24 px-5 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <div class="reveal mb-12">
      <span class="text-xs font-mono text-accent tracking-widest uppercase font-medium">开源项目</span>
      <h2 class="mt-2 text-3xl font-bold text-text">我正在构建的东西</h2>
      <p class="mt-3 text-text-muted max-w-xl">
        每个项目都是为了解决一个我自己遇到的真实问题——本地优先、隐私友好、面向中文开发者。
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>

    <div class="mt-10 text-center reveal stagger-5">
      <a href="https://github.com/Aswellle?tab=repositories" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors duration-200">
        查看全部 <span data-repo-count>13</span> 个仓库
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // 星标数 / 仓库数实时刷新：经同源 Pages Function 代理 GitHub API。
  // 国内访问链路：浏览器 → /api/*（与站点同一 Cloudflare CDN）→ Cloudflare 边缘 → api.github.com，
  // 避免浏览器直连 GitHub 的高延迟与不稳定。服务器端缓存上限 1 小时。
  // 每次进入都向同源 Pages Function 请求最新数据（请求基本命中 CDN 缓存，不消耗 GitHub 配额）；
  // 与本地缓存按 updatedAt 取新合并，跨设备收敛到服务器上"最近一次更新 GitHub 数据"的版本。
  // 显示规则：所有项目卡片都显示星标徽章；取到 ≥1 星时显示星标数字并持续更新，0 星不显示数字。
  // 失败重试：拉取失败以 30 秒间隔重试（最多 3 次）；页面重新获得焦点 / 网络恢复时也触发一次重试。
  const timeoutMs = 5000;
  const CHECK_INTERVAL_MS = 10 * 60 * 1000; // 页面停留期间每 10 分钟刷新一次
  const RETRY_INTERVAL_MS = 30 * 1000;
  const MAX_RETRIES = 3;
  const CACHE_KEY = 'portfolio-github-stars-cache';

  interface GithubCache {
    at: number; // 最近一次成功同步的本地时间戳（元数据）
    stars: Record<string, number>;
    updatedAt: Record<string, string>;
    nonForkRepos?: number;
    nonForkReposUpdatedAt?: string;
  }

  async function fetchJson(url: string): Promise<Record<string, unknown> | null> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const res = await fetch(url, { signal: controller.signal });
      return res.ok ? await res.json() : null;
    } catch {
      return null;
    } finally {
      clearTimeout(timer);
    }
  }

  function readCache(): GithubCache | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<GithubCache>;
      if (!Number.isFinite(parsed.at) || !parsed.stars || !parsed.updatedAt) return null;
      return parsed as GithubCache;
    } catch {
      return null;
    }
  }

  function writeCache(cache: GithubCache): void {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
    } catch {
      // localStorage 不可用（隐私模式等）时静默跳过，下次继续尝试
    }
  }

  // 分钟精度：同日显示"更新于 14:26"，跨日显示"更新于 8月7日 14:26"
  function formatUpdatedAt(iso: string): string {
    const d = new Date(iso);
    const now = new Date();
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    const time = `${hh}:${mm}`;
    return d.toDateString() === now.toDateString()
      ? `更新于 ${time}`
      : `更新于 ${d.getMonth() + 1}月${d.getDate()}日 ${time}`;
  }

  // 收集所有项目卡片（每张卡片都带 data-stars-repo；徽章始终显示，0 星时仅数字隐藏）
  const repoEls = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-stars-repo]').forEach((el) => {
    const repo = el.dataset.starsRepo;
    if (repo) repoEls.set(repo, el);
  });
  const countEl = document.querySelector<HTMLElement>('[data-repo-count]');

  function applyCache(cache: GithubCache): void {
    repoEls.forEach((el, repo) => {
      const stars = cache.stars[repo];
      if (typeof stars === 'number') {
        const valueEl = el.querySelector<HTMLElement>('[data-stars-value]');
        if (valueEl) {
          if (stars >= 1) {
            valueEl.textContent = String(stars);
            valueEl.classList.remove('hidden');
          } else {
            // 0 星：徽章照常显示，仅不显示星标数字
            valueEl.textContent = '';
            valueEl.classList.add('hidden');
          }
        }
      }
      const updatedAt = cache.updatedAt[repo];
      if (updatedAt) {
        let ts = el.parentElement?.querySelector<HTMLElement>('[data-stars-updated]');
        if (!ts) {
          ts = document.createElement('span');
          ts.className = 'text-[10px] text-text-dim leading-none mt-0.5';
          ts.setAttribute('data-stars-updated', '');
          el.after(ts);
        }
        ts.textContent = formatUpdatedAt(updatedAt);
      }
    });
    if (countEl && typeof cache.nonForkRepos === 'number') {
      countEl.textContent = String(cache.nonForkRepos);
    }
  }

  // 拉取最新数据；至少一项成功才返回新缓存。跨设备按 updatedAt 取新合并（本地缓存 vs 服务器），
  // 保证各设备都收敛到"最近一次更新 GitHub 数据的版本"。
  async function fetchLatest(): Promise<GithubCache | null> {
    const freshStars: Record<string, number> = {};
    const freshUpdatedAt: Record<string, string> = {};
    let ok = false;
    const jobs = [...repoEls.keys()].map(async (repo) => {
      const data = await fetchJson(`/api/stars/${repo}`);
      if (data && typeof data.stars === 'number' && typeof data.updatedAt === 'string') {
        freshStars[repo] = data.stars;
        freshUpdatedAt[repo] = data.updatedAt;
        ok = true;
      }
    });
    let nonForkRepos: number | undefined;
    let nonForkReposUpdatedAt: string | undefined;
    if (countEl) {
      jobs.push(
        fetchJson('/api/profile').then((data) => {
          if (data && typeof data.nonForkRepos === 'number' && typeof data.updatedAt === 'string') {
            nonForkRepos = data.nonForkRepos;
            nonForkReposUpdatedAt = data.updatedAt;
            ok = true;
          }
        }),
      );
    }
    await Promise.all(jobs);
    if (!ok) return null;

    const old = readCache();
    const merged: GithubCache = { at: Date.now(), stars: {}, updatedAt: {} };

    // 每个 repo 取 updatedAt 更新的来源；本次未取到（如接口失败）的 repo 沿用旧缓存值
    for (const repo of new Set([...Object.keys(old?.stars ?? {}), ...Object.keys(freshStars)])) {
      const oldTs = old?.updatedAt[repo];
      const newTs = freshUpdatedAt[repo];
      if (newTs !== undefined && (!oldTs || Date.parse(newTs) >= Date.parse(oldTs))) {
        merged.stars[repo] = freshStars[repo];
        merged.updatedAt[repo] = newTs;
      } else if (old && oldTs !== undefined) {
        merged.stars[repo] = old.stars[repo];
        merged.updatedAt[repo] = oldTs;
      }
    }

    // 仓库总数同理按 updatedAt 取新合并
    const oldProfileTs = old?.nonForkReposUpdatedAt;
    if (nonForkRepos !== undefined && nonForkReposUpdatedAt !== undefined
        && (!oldProfileTs || Date.parse(nonForkReposUpdatedAt) >= Date.parse(oldProfileTs))) {
      merged.nonForkRepos = nonForkRepos;
      merged.nonForkReposUpdatedAt = nonForkReposUpdatedAt;
    } else if (old) {
      merged.nonForkRepos = old.nonForkRepos;
      merged.nonForkReposUpdatedAt = old.nonForkReposUpdatedAt;
    }

    return merged;
  }

  let fetching = false;
  let retryCount = 0;
  let retryTimer: ReturnType<typeof setTimeout> | null = null;

  function clearRetryTimer(): void {
    if (retryTimer !== null) {
      clearTimeout(retryTimer);
      retryTimer = null;
    }
  }

  function scheduleRetry(): void {
    if (retryCount >= MAX_RETRIES) {
      // 已达重试上限 → 放弃，等下次页面加载 / 焦点恢复 / 定时检查再试
      retryCount = 0;
      return;
    }
    retryCount++;
    clearRetryTimer();
    retryTimer = setTimeout(refresh, RETRY_INTERVAL_MS);
  }

  function refresh(): void {
    if (fetching) return;
    fetching = true;
    fetchLatest()
      .then((fresh) => {
        if (fresh) {
          retryCount = 0;
          clearRetryTimer();
          applyCache(fresh);
          writeCache(fresh);
        } else {
          scheduleRetry();
        }
      })
      .catch(scheduleRetry)
      .finally(() => {
        fetching = false;
      });
  }

  // 清理旧版节流 key
  try {
    localStorage.removeItem('portfolio-github-refresh-at');
  } catch {
    // 忽略
  }

  // 1) 立即渲染本地缓存（若有）→ 首屏不闪空；最新数据随后由 refresh() 从服务器取新合并
  const cached = readCache();
  if (cached) applyCache(cached);

  // 2) 每次进入都请求最新数据（请求基本命中 CDN 缓存；跨设备按 updatedAt 取新合并）
  refresh();

  // 3) 页面停留期间每 10 分钟刷新一次
  setInterval(refresh, CHECK_INTERVAL_MS);

  // 4) 页面重新获得焦点时刷新（从后台切回前台、切换标签后等场景）
  window.addEventListener('focus', refresh);
  // 网络恢复时刷新（移动网络断续、切换 WiFi 等场景）
  window.addEventListener('online', refresh);

  // 移动端（无 hover 设备）点按卡片：显示与桌面悬停一致的常驻反馈（左侧渐变边线 + 标题变色）。
  // 同一时刻至多一张卡片保持高亮；再次点按该卡片或点按页面其他位置即清除。
  // 桌面设备不挂载此逻辑（matchMedia 门控），视觉规则由 CSS 侧 @media (hover:none) 兜底。
  if (window.matchMedia('(hover: none)').matches) {
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    document.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.project-card');
      const keepTapped = card?.classList.contains('card-tapped') ? false : Boolean(card);
      cards.forEach((c) => c.classList.remove('card-tapped'));
      if (keepTapped && card) card.classList.add('card-tapped');
    });
  }
</script>
